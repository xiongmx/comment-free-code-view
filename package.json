{
  "name": "comment-free-code-view",
  "displayName": "无注释代码视图编辑",
  "description": "在可编辑的无注释拆分视图中修改代码，跟随定位到原文并保留原注释与空白。",
  "version": "1.2.0",
  "publisher": "xiongmx",
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "comments",
    "注释",
    "空白行"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:copyCleanCode.toggleFullLineComments"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "nginx",
        "aliases": [
          "Nginx",
          "nginx"
        ],
        "filenames": [
          "nginx.conf"
        ],
        "extensions": [
          ".nginx"
        ]
      }
    ],
    "commands": [
      {
        "command": "copyCleanCode.toggleFullLineComments",
        "title": "去注释视图编辑",
        "category": "注释"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "copyCleanCode.toggleFullLineComments",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste@5"
        }
      ],
      "commandPalette": [
        {
          "command": "copyCleanCode.toggleFullLineComments"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "npm run build",
    "test": "node --test test/strip.test.mjs test/sync.test.mjs test/extension.test.cjs",
    "test:integration": "xvfb-run -a node test/run-integration.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --out artifacts/comment-free-code-view-1.2.0.vsix"
  },
  "dependencies": {
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@types/vscode": "1.99.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  }
}
